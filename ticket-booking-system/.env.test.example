# Credentials for a SEPARATE Supabase project used only for tests.
# Run migrations 001-014 in that project first. Never point this at your real project:
# the tests create and delete users, events, bookings and tickets.
SUPABASE_URL=https://your-TEST-project-ref.supabase.co
SUPABASE_ANON_KEY=your-test-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-or-secret-key
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# Any value works, but the API and the tests must use the SAME one.
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where the API under test is running
API_BASE_URL=http://localhost:8001
